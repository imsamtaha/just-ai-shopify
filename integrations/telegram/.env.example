# Enter real values with: python configure.py
TELEGRAM_BOT_TOKEN=
AI_PROVIDER=openai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENAI_API_KEY=
# Choose a Responses-compatible model available to your API account.
OPENAI_MODEL=
# Numeric Telegram user IDs, comma separated. Empty = setup commands only.
ALLOWED_USER_IDS=
BOT_USERNAME=@JustAI_chatbot
EXPECTED_BOT_USERNAME=JustAI_chatbot
DAILY_AI_LIMIT=30
COOLDOWN_SECONDS=3
MAX_OUTPUT_TOKENS=1600
# Optional Meta channels. Configure privately with setup-meta-windows.cmd.
META_APP_ID=
META_GRAPH_VERSION=
META_PUBLIC_URL=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_BUSINESS_PHONE=
META_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_WHATSAPP_ALLOWED_IDS=
META_MESSENGER_ALLOWED_IDS=
# Optional store management. Configure with python configure_shopify.py.
SHOPIFY_ENABLED=false
SHOPIFY_SHOP_DOMAIN=just-ai-store.myshopify.com
SHOPIFY_EXPECTED_SHOP_ID=gid://shopify/Shop/103597179156
SHOPIFY_API_VERSION=2026-10
# Must also be present in ALLOWED_USER_IDS. Never use a username as authorization.
SHOPIFY_OWNER_IDS=
# Choose ONE method: existing Admin access token OR client ID + client secret.
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
